<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (phone/settings surfaces and launchers such as Plume; stock Android TV
     uses the leanback android:banner). docs/brand.md §2: the flat mascot on the #1A1D15 ground;
     the monochrome layer shares its cut-out silhouette. tools/launcher-icon/check.py guards it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
