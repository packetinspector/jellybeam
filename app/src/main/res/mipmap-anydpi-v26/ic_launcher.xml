<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (phone/settings surfaces; Android TV itself uses the leanback
     android:banner). docs/brand.md §2: the mascot icon inside the 66dp safe zone on the
     #1A1D15 ground; the monochrome layer reuses the foreground. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
